{
  "name": "blockout-cs16-map-builder",
  "version": "1.17.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "prepare:web": "node scripts/prepare-public.mjs",
    "prepare:manifest": "node scripts/prepare-public-manifest.mjs",
    "dev": "node scripts/prepare-public.mjs && vinext dev",
    "build": "node scripts/prepare-public.mjs && vinext build && node scripts/prepare-sites.mjs",
    "check": "node --check app.js && python scripts/test_official_wad_catalog.py && node scripts/verify-public-release.mjs",
    "test:blueprint": "node scripts/headless-blueprint-architect-test.mjs",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1",
    "start": "vinext start"
  },
  "dependencies": {
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "vinext": "1.0.0-beta.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.4",
    "@vitejs/plugin-rsc": "^0.5.30",
    "vite": "^8.1.5"
  }
}
